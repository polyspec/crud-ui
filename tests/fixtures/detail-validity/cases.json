                  {
                    "kind": "text",
                    "value": "base-fields.yml"
                  }
                ],
                [
                  "$patch",
                  {
                    "kind": "map",
                    "value": [
                      [
                        "extra",
                        {
                          "kind": "map",
                          "value": [
                            [
                              "field",
                              {
                                "kind": "text",
                                "value": "extra"
                              }
