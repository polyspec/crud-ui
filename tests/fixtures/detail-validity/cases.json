{
  "cases": [
    {
      "id": "ok_basic_detail",
      "name": "ok-basic-detail",
      "requirements": [
        "CUDF-032",
        "CUDF-034",
        "CUDF-041",
        "CUDF-043",
        "CUDF-045",
        "CUDF-046",
        "CUDF-047",
        "CUDF-048",
        "CUDF-049",
        "CUDF-051",
        "CUDF-052",
        "CUSC-001"
      ],
      "note": "the smallest valid detail specification with text and badge fields.",
      "expect": "ok",
      "spec": {
        "kind": "map",
        "value": [
          [
            "fields",
            {
              "kind": "map",
              "value": [
                [
                  "name",
                  {
                    "kind": "map",
                    "value": [
                      [
                        "field",
                        {
                          "kind": "text",
                          "value": "name"
                        }
                      ],
                      [
                        "label",
                        {
                          "kind": "text",
                          "value": "Name"
                        }
                      ],
                      [
                        "format",
                        {
                          "kind": "text",
                          "value": "text"
                        }
                      ]
                    ]
                  }
                ],
                [
                  "state",
                  {
                    "kind": "map",
                    "value": [
                      [
                        "field",
                        {
                          "kind": "text",
                          "value": "state"
                        }
                      ],
                      [
                        "format",
                        {
                          "kind": "map",
                          "value": [
                            [
                              "type",
                              {
                                "kind": "text",
                                "value": "badge"
                              }
                            ],
                            [
                              "map",
                              {
                                "kind": "map",
                                "value": [
                                  [
                                    "active",
                                    {
                                      "kind": "text",
                                      "value": "success"
                                    }
                                  ]
                                ]
                              }
                            ]
                          ]
                        }
                      ]
                    ]
                  }
                ]
              ]
            }
          ]
        ]
      }
    },
    {
      "id": "red_detail_sortable",
      "name": "red-detail-sortable",
      "note": "sortable is a list column key; the meta-schema rejects it on a detail field, and the four-language engine accepts it because it is not a forbidden key.",
      "expect": "fail",
      "reason": "additionalProperties",
      "spec": {
        "kind": "map",
        "value": [
          [
            "fields",
            {
              "kind": "map",
              "value": [
                [
                  "name",
                  {
                    "kind": "map",
                    "value": [
                      [
                        "field",
                        {
                          "kind": "text",
                          "value": "name"
                        }
                      ],
                      [
                        "sortable",
                        {
                          "kind": "bool",
                          "value": true
                        }
                      ]
                    ]
                  }
                ]
              ]
            }
          ]
        ]
      }
    },
    {
      "id": "ok_compose_ref_patch_fields",
      "name": "ok-compose-ref-patch-fields",
      "requirements": [
        "CUSC-007"
      ],
      "note": "$ref and $patch on the fields map use the same composition engine as form properties; files resolve the base for the engine.",
      "expect": "ok",
      "options": {
        "files": {
          "base-fields.yml": {
            "kind": "map",
            "value": [
              [
                "properties",
                {
                  "kind": "map",
                  "value": [
                    [
                      "name",
                      {
                        "kind": "map",
                        "value": [
                          [
                            "field",
                            {
                              "kind": "text",
                              "value": "name"
                            }
                          ],
                          [
                            "label",
                            {
                              "kind": "text",
                              "value": "Name"
                            }
                          ]
                        ]
                      }
                    ]
                  ]
                }
              ]
            ]
          }
        }
      },
      "spec": {
        "kind": "map",
        "value": [
          [
            "fields",
            {
              "kind": "map",
              "value": [
                [
                  "$ref",
                  {
                    "kind": "text",
                    "value": "base-fields.yml"
                  }
                ],
                [
                  "$patch",
                  {
                    "kind": "map",
                    "value": [
                      [
                        "extra",
                        {
                          "kind": "map",
                          "value": [
                            [
                              "field",
                              {
                                "kind": "text",
                                "value": "extra"
                              }
                            ],
                            [
                              "label",
                              {
                                "kind": "text",
                                "value": "Extra"
                              }
                            ]
                          ]
                        }
                      ]
                    ]
                  }
                ]
              ]
            }
          ]
        ]
      }
    },
    {
      "id": "root_ref_without_own_fields",
      "name": "root-ref-without-own-fields",
      "note": "a root $ref inherits a base detail specification exposed under a properties layer. The meta-schema reads only spec and requires fields; the four-language engine composes the base and accepts it.",
      "expect": "fail",
      "reason": "required",
      "options": {
        "files": {
          "base-detail.yml": {
            "kind": "map",
            "value": [
              [
                "properties",
                {
                  "kind": "map",
                  "value": [
                    [
                      "fields",
                      {
                        "kind": "map",
                        "value": [
                          [
                            "name",
                            {
                              "kind": "map",
                              "value": [
                                [
                                  "field",
                                  {
                                    "kind": "text",
                                    "value": "name"
                                  }
                                ]
                              ]
                            }
                          ]
                        ]
                      }
                    ]
                  ]
                }
              ]
            ]
          }
        }
      },
      "spec": {
        "kind": "map",
        "value": [
          [
            "$ref",
            {
              "kind": "text",
              "value": "base-detail.yml"
            }
          ]
        ]
      }
    },
    {
      "id": "red_forbidden_field_key",
      "name": "red-forbidden-field-key",
      "note": "a forbidden condition meta key used as a field key is a load failure.",
