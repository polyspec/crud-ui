{
  "name": "polyspec/crudui-native-runtime",
  "description": "Application and PHPUnit autoload for explicitly loaded native SDK modules",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": ">=8.4"
  },
  "require-dev": {
    "phpunit/phpunit": "^13.4.3"
  },
  "autoload": {
    "psr-4": {
      "Polyspec\\Crudui\\FormComparison\\": "../src/",
      "Polyspec\\CruduiTestSupport\\": "../../../../../tests/php/",
      "Polyspec\\Crudui\\Generator\\Tests\\": "../../../../../legacy/packages/generator/php/tests/",
      "Polyspec\\Crudui\\Validator\\Tests\\": "../../../../../legacy/packages/validator/php/tests/",
      "Polyspec\\Crudui\\Extension\\Tests\\": "../../../../../legacy/packages/php-ext/tests/",
      "Polyspec\\Crudui\\FormComparison\\Tests\\": "../tests/",
      "Polyspec\\Crudui\\Conformance\\": "../../../../../tests/conformance/php/"
    }
  },
  "config": {
    "platform": {
      "php": "8.4.27"
    }
  }
}
