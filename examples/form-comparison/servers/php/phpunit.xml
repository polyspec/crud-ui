<?xml version="1.0" encoding="UTF-8"?>
<!--
  The PHPUnit suite of the PHP record server of the form comparison. Both modes read JSON through the polyspec_json
  extension that the run loads. FORM_PHP_SERVER selects the mode: php runs the PHP library, php-ext the crudui extension
  that the run loads; the group modules starts child processes with the extension modules that POLYSPEC_JSON_MODULE and
  FORM_CRUDUI_MODULE name.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="../../../../vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="../../../../tests/php/bootstrap.php"
         colors="true"
         failOnRisky="true"
         failOnWarning="true"
         failOnNotice="true"
         failOnDeprecation="true"
         cacheDirectory="../../../../var/phpunit/form-comparison">
    <testsuites>
        <testsuite name="form-comparison">
            <directory>tests</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>src</directory>
        </include>
    </source>
</phpunit>
