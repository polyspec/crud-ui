  "changes": [
    {
      "id": "package-names",
      "rule": "P-1",
      "reason": "P-1: one form of names: Composer polyspec/crudui-validator, PHP Polyspec\\CruduiValidator, PyPI polyspec-crudui-validator, Python polyspec.crudui_validator; the PHP classes Polyspec\\Crudui\\Validator and the Python package polyspec.crudui.validator move, npm @polyspec/crudui-validator",
      "symbol": "Polyspec\\Crudui\\Validator, polyspec.crudui.validator",
      "from": {
        "php": "final class Polyspec\\Crudui\\Validator (static methods)",
        "python": "import polyspec.crudui.validator"
      },
      "to": "validator"
    },
    {
      "id": "validate",
      "rule": "T-4",
      "reason": "T-4: the options are one record in every language; P-10: a PHP array or stdClass of options is a second form",
      "symbol": "validate",
      "from": {
        "php": "Validator::validate(array|\\stdClass $spec, array|\\stdClass $data, array $options = []): \\stdClass",
        "node": "validate(spec, data, options?: ValidateOptions): ValidationResult",
        "python": "validate(spec, data, options=None)",
        "go": "Validate(spec, data any, options ...Option) (Result, error)"
      },
      "to": "validator.validate"
    },
    {
      "id": "validate-list",
      "rule": "CUDF-024",
      "reason": "CUDF-024: a list declaration that breaks its rules fails with its kind (F-3); a valid one returns nothing, so the result record {valid, errors} of the language APIs, whose errors are always empty, is not kept",
      "symbol": "validateList",
      "from": {
        "php": "Validator::validateList(array|\\stdClass $spec, array $options = []): \\stdClass",
        "node": "validateList(spec, options?): ValidationResult"
      },
      "to": "validator.validate_list"
    },
    {
      "id": "validate-detail",
      "rule": "CUDF-032",
      "reason": "CUDF-032: as validate-list, for a detail declaration",
      "symbol": "validateDetail",
      "from": {
        "php": "Validator::validateDetail(array|\\stdClass $spec, array $options = []): \\stdClass",
        "node": "validateDetail(spec, options?): ValidationResult"
      },
      "to": "validator.validate_detail"
    },
    {
      "id": "errors",
      "rule": "E-2",
      "reason": "E-2, E-3: every error is a library class with kind(); the code getter getErrorCode() and the code strings (REF_FILE_NOT_FOUND) become the kinds in lower snake case, and PHP \\RuntimeException subclasses become CruduiValueError subclasses",
      "symbol": "ComposeLoadError, FormInputError",
      "from": {
        "php": "final class ComposeLoadError extends \\RuntimeException { getErrorCode(): string; getCompositionTrace(): array; __get; __isset }; final class FormInputError extends \\RuntimeException { getErrorCode(): string }",
        "node": "class ComposeLoadError extends Error { code; trace }; class FormInputError extends Error { code }"
      },
      "to": "compose_load_error"
    },
    {
      "id": "hidden-paths",
      "rule": "CURP-029",
      "reason": "CURP-029: hiddenPaths serves the browser form binding, a browser layer; the hidden paths are the member hidden of the validation result",
      "symbol": "hiddenPaths",
      "from": {
        "node": "hiddenPaths(spec, data): string[]"
      },
      "to": null
    }
  ],
