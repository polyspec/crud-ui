{
  "name": "@polyspec/crudui-form-binding",
  "version": "0.0.14",
  "description": "Browser validation of server-rendered CRUDUI forms",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node ../../scripts/package-dist.mts build 'tsup src/index.ts --format esm --clean --out-dir \"$CRUDUI_DIST\" && tsc --project tsconfig.build.json --outDir \"$CRUDUI_DIST\"'",
    "typecheck": "status=0; tsc --noEmit || status=1; tsc --noEmit --project tsconfig.tests.json || status=1; exit $status",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "form",
    "validation",
    "browser",
    "yaml"
  ],
  "license": "MIT",
  "dependencies": {
    "@polyspec/crudui-generator-core": "0.0.14",
    "@polyspec/crudui-generator-html": "0.0.14",
    "@polyspec/crudui-validator": "0.0.14"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.2",
    "tsup": "^9.0.0",
    "typescript": "7.0.2",
    "vitest": "^5.0.4"
  },
  "repository": {
    "type": "git",
    "url": ""
  },
  "bugs": {
    "url": ""
  },
  "engines": {
    "node": ">=26.12.0"
  }
}
